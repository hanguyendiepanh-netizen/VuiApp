# Copy this file to .env.local for local dev, and add the same 3 values
# to Vercel Project Settings -> Environment Variables for prod/preview.

# Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Dashboard -> Project Settings -> API -> anon public key
# Not used server-side for writes, but harmless to keep for future client reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase Dashboard -> Project Settings -> API -> service_role key
# SERVER-ONLY. Never expose this to the browser. Do NOT prefix with NEXT_PUBLIC_.
# Used by app/api/* route handlers to bypass RLS with trusted server logic.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
